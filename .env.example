# Backend database. SQLite is convenient for local development.
DATABASE_URL=sqlite:///./dev.db

# Required for Gemini generation.
GOOGLE_API_KEY=your_google_api_key

# Optional: enables current web research and source citations.
TAVILY_API_KEY=your_tavily_api_key
CORS_ORIGINS=https://leadforgeai0i0.vercel.app

# Frontend (place this in frontend/.env when running Vite).
VITE_API_URL=http://127.0.0.1:8000
